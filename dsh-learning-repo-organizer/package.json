{
  "name": "dsh-learning-repo-organizer",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Learning repository organizer for DeepSeek Harness: embeds the learning-repo-organizer skill, a run_tests tool, and a WebUI dashboard for C, Python, and Arduino practice repositories.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills",
    "scripts/selftest*.mjs",
    "README.md"
  ],
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
